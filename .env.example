# ===== 浏览器接管配置 =====
# Chrome/Edge 可执行文件路径;留空则自动在常见安装位置探测
BROWSER_PATH=
# CDP 调试端口
CDP_PORT=9222
# 专用浏览器配置目录(登录态保存在这里;Chrome 136+ 禁止默认 profile 使用调试端口,故用独立目录)
BROWSER_PROFILE_DIR=./data/browser_profile

# ===== 抓取行为 =====
# 页面动作间随机延迟范围(秒),防风控
DELAY_MIN=3
DELAY_MAX=8
# 详情页打开间隔(秒),约 1s 打开一个岗位页
DETAIL_DELAY=1
# 单次任务最多抓取页数(每词条)
MAX_PAGES_PER_TASK=10
# HR 最近活跃阈值(天),超出则不入库
HR_ACTIVE_DAYS=7
# 岗位发布时间阈值(天),超出则不入库
JOB_PUBLISH_DAYS=7

# ===== LLM 自动备注(可选) =====
# 留空则不启用 LLM,仅使用关键词规则
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
