# ===== 浏览器接管配置 =====
# Chrome/Edge 可执行文件路径;留空则自动在常见安装位置探测
BROWSER_PATH=
# CDP 调试端口
CDP_PORT=9222
# 专用浏览器配置目录(登录态保存在这里;Chrome 136+ 禁止默认 profile 使用调试端口,故用独立目录)
BROWSER_PROFILE_DIR=./data/browser_profile

# ===== 抓取行为 =====
# 页面动作间随机延迟范围(秒),防风控;前端「随机间隔」设置框按任务覆盖此兜底值
DELAY_MIN=3
DELAY_MAX=8
# 详情页打开间隔兜底(无任务级设置时生效,如"补全HR活跃"):随机 3~8 秒
# (固定高频访问会被平台限流,Boss 实测约 1s/条 800 条即触发"访问受限")
DETAIL_DELAY_MIN=3
DETAIL_DELAY_MAX=8
# 单次任务最多抓取页数(每词条)
MAX_PAGES_PER_TASK=10
# HR 最近活跃阈值(天),超出则不入库
HR_ACTIVE_DAYS=7
# 岗位发布时间阈值(天),超出则不入库
JOB_PUBLISH_DAYS=7

# ===== 原始数据留存(排查用) =====
# 解析前边界的平台原始响应/提取产物落盘 JSON 到 data/raw/{平台}/,
# 字段语义或结构变化时直接翻文件排查,不必再针对平台重放测试。
# 0 = 关闭留存
RAW_CAPTURE=1
# 保留天数(按文件修改时间滚动清理,0=不限)
RAW_RETENTION_DAYS=7
# 每平台保留文件数上限(超出删最旧,0=不限)
RAW_MAX_PER_PLATFORM=300

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
